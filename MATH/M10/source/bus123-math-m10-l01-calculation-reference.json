{
  "description": "Original maintained M10 deck retained as the calculation and workbook reference during the foundations revision.",
  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>MATH-M10-L01 &middot; Stocks, Bonds, and Mutual Funds</title>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,700;0,6..96,900;1,6..96,400;1,6..96,700&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=JetBrains+Mono:wght@400;500;700&display=swap\" rel=\"stylesheet\">\n  <style>\n    :root{\n      --ink:#0E1116;\n      --paper:#FAF8F3;\n      --paper-2:#F2EEE5;\n      --white:#FFFFFF;\n      --text:#1A1F2C;\n      --text-soft:#4A5567;\n      --muted:#7A8290;\n      --border:#E5E1D6;\n      --sage:#4A7C5E;\n      --gold:#B8843D;\n      --terra:#9C4A2B;\n      --steel:#355773;\n      --formula-bg:#EAF3EC;\n      --gradient:linear-gradient(90deg,var(--gold),var(--terra),var(--sage));\n      --serif:\"Bodoni Moda\",serif;\n      --sans:\"DM Sans\",sans-serif;\n      --mono:\"JetBrains Mono\",monospace;\n    }\n    *{box-sizing:border-box}\n    html,body{margin:0;width:100%;height:100%;overflow:hidden;background:var(--ink);font-family:var(--sans);color:var(--text)}\n    .deck-shell{position:fixed;left:0;top:0;width:1280px;height:720px;transform-origin:0 0;display:flex;background:var(--ink)}\n    .tab-strip{width:84px;background:var(--ink);padding:18px 12px;display:flex;flex-direction:column;gap:10px;border-right:1px solid rgba(250,248,243,.14)}\n    .home-dot{width:28px;height:28px;border:0;border-radius:50%;background:var(--gradient);cursor:pointer;margin:0 auto 18px}\n    .tab{border:1px solid rgba(250,248,243,.18);background:transparent;color:rgba(250,248,243,.72);border-radius:8px;padding:12px 6px;font:700 11px/1 var(--mono);letter-spacing:.08em;text-transform:uppercase;cursor:pointer;writing-mode:vertical-rl;transform:rotate(180deg)}\n    .tab.active{background:var(--paper);color:var(--ink)}\n    .stage{position:relative;width:1196px;height:720px;background:var(--ink);overflow:hidden}\n    .slide{position:absolute;inset:0;display:none;padding:48px 58px}\n    .slide.active{display:block}\n    .slide.dark{background:var(--ink);color:var(--paper)}\n    .slide.paper{background:var(--paper);color:var(--text)}\n    .slide.terra{background:var(--terra);color:var(--paper)}\n    .gradient-bar{height:8px;width:170px;background:var(--gradient);border-radius:99px;margin-bottom:28px}\n    .eyebrow{font:700 15px/1 var(--mono);letter-spacing:.13em;text-transform:uppercase;color:var(--sage);margin-bottom:14px}\n    .dark .eyebrow,.terra .eyebrow{color:var(--gold)}\n    h1,h2,h3,p{margin:0}\n    h1{font-family:var(--serif);font-size:72px;line-height:.93;max-width:880px}\n    h2{font-family:var(--serif);font-size:46px;line-height:1.02;margin-bottom:20px}\n    h3{font-size:24px;line-height:1.2;margin-bottom:10px}\n    p,.body{font-size:20px;line-height:1.42;color:var(--text-soft)}\n    .dark p,.terra p{color:rgba(250,248,243,.78)}\n    .subtitle{font-family:var(--serif);font-style:italic;font-size:30px;color:rgba(250,248,243,.8);margin-top:22px;max-width:780px}\n    .rule{height:3px;background:var(--sage);width:100%;margin:2px 0 28px}\n    .gold-rule{background:var(--gold)}\n    .terra-rule{background:var(--terra)}\n    .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:24px}\n    .grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}\n    .card{background:var(--white);border:1px solid var(--border);border-radius:8px;padding:22px;min-height:118px}\n    .card.tint{background:var(--paper-2)}\n    .card strong{color:var(--text)}\n    .num{font-family:var(--serif);font-size:72px;line-height:1;color:var(--sage);font-weight:900}\n    .big-stat{font-family:var(--serif);font-size:140px;line-height:.85;color:var(--gold);font-weight:900}\n    .formula-panel{background:var(--formula-bg);color:var(--ink);border-left:4px solid var(--sage);padding:20px 22px;border-radius:8px;font-family:var(--mono);font-size:18px;font-weight:500;line-height:1.45}\n    .formula-panel .fn{display:block;font-size:22px;font-weight:700;color:var(--steel);margin-bottom:14px}\n    .formula-panel .result{display:block;color:var(--sage);font-weight:700;margin-top:8px}\n    .formula-panel .comment{display:block;color:var(--text-soft)}\n    .mini-sheet{border:1px solid var(--border);border-radius:8px;overflow:hidden;background:var(--white)}\n    .mini-row{display:grid;grid-template-columns:repeat(6,1fr)}\n    .mini-row.cols-5{grid-template-columns:1.2fr 1fr 1fr 1fr 1fr}\n    .mini-row div{padding:10px 12px;border-right:1px solid var(--border);border-bottom:1px solid var(--border);font-size:17px;min-height:42px}\n    .mini-row div:last-child{border-right:0}\n    .mini-head div{background:var(--ink);color:var(--gold);font-family:var(--mono);font-weight:700}\n    .mini-result div{background:var(--formula-bg);font-weight:700;color:var(--sage)}\n    .process{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}\n    .process .step{background:var(--white);border-left:5px solid var(--sage);padding:18px;border-radius:8px;min-height:120px}\n    .callout{background:var(--paper-2);border:1px solid var(--border);border-left:5px solid var(--gold);border-radius:8px;padding:20px}\n    .yellow-cell{display:inline-block;background:var(--gold);color:var(--ink);font-family:var(--mono);font-weight:700;padding:3px 8px;border-radius:4px}\n    .nav{position:fixed;right:18px;bottom:18px;display:flex;gap:8px;align-items:center;z-index:20}\n    .nav button{width:38px;height:38px;border:1px solid rgba(250,248,243,.22);border-radius:8px;background:var(--ink);color:var(--paper);font:700 16px var(--mono);cursor:pointer}\n    .counter{font:700 13px var(--mono);color:var(--paper);background:var(--ink);border:1px solid rgba(250,248,243,.22);border-radius:8px;padding:11px 14px}\n    .notes{position:fixed;left:104px;right:24px;bottom:70px;display:none;background:var(--ink);color:var(--paper);border:1px solid rgba(250,248,243,.2);border-radius:8px;padding:18px 20px;z-index:18}\n    .notes.visible{display:block}\n    .notes strong{display:block;color:var(--gold);font:700 12px var(--mono);letter-spacing:.12em;text-transform:uppercase;margin-bottom:8px}\n  </style>\n</head>\n<body>\n  <div class=\"deck-shell\">\n    <nav class=\"tab-strip\" aria-label=\"Slide sections\">\n      <button class=\"home-dot\" onclick=\"goTo(0)\" aria-label=\"Go to title slide\"></button>\n      <button class=\"tab\" data-section=\"1\" onclick=\"jumpSection(1)\">Stocks</button>\n      <button class=\"tab\" data-section=\"2\" onclick=\"jumpSection(2)\">Returns</button>\n      <button class=\"tab\" data-section=\"3\" onclick=\"jumpSection(3)\">Bonds Funds</button>\n    </nav>\n    <main class=\"stage\">\n      <section class=\"slide dark active\" data-section=\"0\">\n        <div class=\"gradient-bar\"></div>\n        <div class=\"eyebrow\">MATH-M10-L01 &middot; Meridian Advisory Group</div>\n        <h1>Stocks, Bonds, and Mutual Funds</h1>\n        <p class=\"subtitle\">Turning market data into Excel-backed investment decisions.</p>\n      </section>\n\n      <section class=\"slide paper\" data-section=\"0\">\n        <div class=\"eyebrow\">Today&apos;s Desk</div>\n        <h2>Three Investment Math Moves</h2>\n        <div class=\"rule\"></div>\n        <div class=\"grid-3\">\n          <div class=\"card\"><div class=\"num\">1</div><h3>Read the stock quote</h3><p>Bid, ask, last price, dividend yield, and P/E interpretation.</p></div>\n          <div class=\"card\"><div class=\"num\">2</div><h3>Measure stock returns</h3><p>Dividend allocation and ROI after commissions and dividends.</p></div>\n          <div class=\"card\"><div class=\"num\">3</div><h3>Compare pooled choices</h3><p>Bond price, current yield, mutual fund NAV, and purchase cost.</p></div>\n        </div>\n      </section>\n\n      <section class=\"slide paper\" data-section=\"0\">\n        <div class=\"eyebrow\">I Can</div>\n        <h2>By the end, you can defend a recommendation</h2>\n        <div class=\"rule\"></div>\n        <div class=\"grid-2\">\n          <div class=\"card tint\"><h3>Calculate</h3><p>Use Excel formulas for spreads, dividends, ROI, bond yield, and NAV.</p></div>\n          <div class=\"card\"><h3>Interpret</h3><p>Explain what each result means to a Meridian client.</p></div>\n          <div class=\"card\"><h3>Extract</h3><p>Pull inputs out of a scenario before touching the final answer cell.</p></div>\n          <div class=\"card tint\"><h3>Check</h3><p>Use the Live You Try It feedback before moving into Class Challenge.</p></div>\n        </div>\n      </section>\n\n      <section class=\"slide paper\" data-section=\"0\">\n        <div class=\"eyebrow\">Bridge from M09</div>\n        <h2>Investment math still asks: what is this cash flow worth?</h2>\n        <div class=\"rule\"></div>\n        <div class=\"grid-2\">\n          <div class=\"callout\"><h3>Stocks</h3><p>You pay today for a share of future profits and possible price appreciation.</p></div>\n          <div class=\"callout\"><h3>Bonds</h3><p>You lend money today and receive interest plus principal later.</p></div>\n          <div class=\"callout\"><h3>Mutual funds</h3><p>Your money is pooled into a basket; NAV prices one share of that basket.</p></div>\n          <div class=\"formula-panel\"><span class=\"fn\">Excel habit for today</span><span class=\"comment\">Inputs first. Formulas second. Interpretation last.</span></div>\n        </div>\n      </section>\n\n      <section class=\"slide dark\" data-section=\"1\">\n        <div class=\"gradient-bar\"></div>\n        <div class=\"eyebrow\">Part 1</div>\n        <h1>Reading the stock quote</h1>\n        <p class=\"subtitle\">The quote is not the answer. It is the input map.</p>\n      </section>\n\n      <section class=\"slide paper\" data-section=\"1\">\n        <div class=\"eyebrow\">MAGH Quote</div>\n        <h2>What do we know before we calculate?</h2>\n        <div class=\"rule\"></div>\n        <div class=\"mini-sheet\">\n          <div class=\"mini-row mini-head\"><div>Symbol</div><div>Last</div><div>Bid</div><div>Ask</div><div>52-Wk Low</div><div>P/E</div></div>\n          <div class=\"mini-row\"><div>MAGH</div><div>$39.62</div><div>$39.55</div><div>$39.68</div><div>$31.20</div><div>18.4</div></div>\n          <div class=\"mini-row mini-result\"><div>Dividend/share</div><div>$1.21</div><div>Spread?</div><div>Above low?</div><div>Yield?</div><div>Interpret?</div></div>\n        </div>\n        <p style=\"margin-top:24px;\">Students should identify which cells are inputs before building the formulas.</p>\n      </section>\n\n      <section class=\"slide paper\" data-section=\"1\">\n        <div class=\"eyebrow\">Worked Example</div>\n        <h2>Three quick reads from the quote</h2>\n        <div class=\"rule\"></div>\n        <div class=\"grid-2\">\n          <div class=\"formula-panel\"><span class=\"fn\">=Ask - Bid</span><span class=\"comment\">=$39.68 - $39.55</span><span class=\"result\">Bid-ask spread = $0.13</span></div>\n          <div class=\"formula-panel\"><span class=\"fn\">=Last - 52WeekLow</span><span class=\"comment\">=$39.62 - $31.20</span><span class=\"result\">Above low = $8.42</span></div>\n          <div class=\"formula-panel\"><span class=\"fn\">=Dividend / Last</span><span class=\"comment\">=$1.21 / $39.62</span><span class=\"result\">Dividend yield = 3.05%</span></div>\n          <div class=\"card tint\"><h3>P/E interpretation</h3><p>A P/E ratio of <strong>18.4</strong> means investors pay about <strong>$18.40</strong> for every $1 of earnings.</p></div>\n        </div>\n      </section>\n\n      <section class=\"slide paper\" data-section=\"1\">\n        <div class=\"eyebrow\">Live You Try It</div>\n        <h2>Pause 1: rebuild the stock quote formulas</h2>\n        <div class=\"rule\"></div>\n        <div class=\"grid-2\">\n          <div class=\"card\"><h3>In the workbook</h3><p>Open <strong>Live You Try It</strong>. Enter $39.55, $39.68, $39.62, $31.20, and 18.4 into the yellow input cells.</p></div>\n          <div class=\"card tint\"><h3>Then build formulas</h3><p>Use the yellow input cells to calculate spread, dollars above the low, and P/E interpretation. Watch the feedback cells.</p></div>\n        </div>\n      </section>\n\n      <section class=\"slide dark\" data-section=\"2\">\n        <div class=\"gradient-bar\"></div>\n        <div class=\"eyebrow\">Part 2</div>\n        <h1>Dividends and ROI</h1>\n        <p class=\"subtitle\">Returns are not just price changes.</p>\n      </section>\n\n      <section class=\"slide paper\" data-section=\"2\">\n        <div class=\"eyebrow\">Worked Example</div>\n        <h2>Preferred shareholders get paid first</h2>\n        <div class=\"rule gold-rule\"></div>\n        <div class=\"process\">\n          <div class=\"step\"><h3>1</h3><p>Preferred dividend/share: 8% &times; $50 = $4.00</p></div>\n          <div class=\"step\"><h3>2</h3><p>Total preferred: $4.00 &times; 1,000 = $4,000</p></div>\n          <div class=\"step\"><h3>3</h3><p>Remainder: $10,000 &minus; $4,000 = $6,000</p></div>\n          <div class=\"step\"><h3>4</h3><p>Common dividend/share: $6,000 &divide; 4,000 = $1.50</p></div>\n        </div>\n        <div class=\"formula-panel\" style=\"margin-top:22px;\"><span class=\"fn\">=(TotalDiv - (Rate * Par * PreferredShares)) / CommonShares</span><span class=\"comment\">Use inputs, not typed answer numbers.</span></div>\n      </section>\n\n      <section class=\"slide paper\" data-section=\"2\">\n        <div class=\"eyebrow\">Live You Try It</div>\n        <h2>Pause 2: build the dividend waterfall</h2>\n        <div class=\"rule gold-rule\"></div>\n        <div class=\"grid-2\">\n          <div class=\"card tint\"><h3>Enter the givens</h3><p>$10,000 dividends, 8% preferred rate, $50 par, 1,000 preferred shares, 4,000 common shares.</p></div>\n          <div class=\"card\"><h3>Reference those cells</h3><p>Calculate preferred dividend/share, total preferred dividend, remainder, and common dividend/share.</p></div>\n        </div>\n      </section>\n\n      <section class=\"slide paper\" data-section=\"2\">\n        <div class=\"eyebrow\">Worked Example</div>\n        <h2>ROI includes commissions and dividends</h2>\n        <div class=\"rule gold-rule\"></div>\n        <div class=\"mini-sheet\">\n          <div class=\"mini-row cols-5 mini-head\"><div>Input</div><div>Shares</div><div>Buy</div><div>Sell</div><div>Commission</div></div>\n          <div class=\"mini-row cols-5\"><div>MAGH trade</div><div>200</div><div>$39.09</div><div>$41.10</div><div>1%</div></div>\n          <div class=\"mini-row cols-5 mini-result\"><div>Dividend/share</div><div>$1.21</div><div>Total cost</div><div>$7,896.18</div><div>ROI 6.12%</div></div>\n        </div>\n        <div class=\"formula-panel\" style=\"margin-top:22px;\"><span class=\"fn\">=(NetProceeds - TotalBuyCost + Dividends) / TotalBuyCost</span><span class=\"comment\">=($8,137.80 - $7,896.18 + $242.00) / $7,896.18</span><span class=\"result\">ROI = 6.12%</span></div>\n      </section>\n\n      <section class=\"slide paper\" data-section=\"2\">\n        <div class=\"eyebrow\">Live You Try It</div>\n        <h2>Pause 3: make ROI formula-driven</h2>\n        <div class=\"rule gold-rule\"></div>\n        <div class=\"grid-2\">\n          <div class=\"card\"><h3>Input cells</h3><p>200 shares, $39.09 buy price, $41.10 sale price, 1% commission, $1.21 dividend/share.</p></div>\n          <div class=\"card tint\"><h3>Formula cells</h3><p>Build buy cost, buy commission, sale proceeds, sell commission, dividends, and ROI by referencing the input cells.</p></div>\n        </div>\n      </section>\n\n      <section class=\"slide dark\" data-section=\"3\">\n        <div class=\"gradient-bar\"></div>\n        <div class=\"eyebrow\">Part 3</div>\n        <h1>Bonds and pooled investments</h1>\n        <p class=\"subtitle\">Different products, same discipline: map inputs before formulas.</p>\n      </section>\n\n      <section class=\"slide paper\" data-section=\"3\">\n        <div class=\"eyebrow\">Worked Example</div>\n        <h2>A bond quote is a percent of par</h2>\n        <div class=\"rule terra-rule\"></div>\n        <div class=\"grid-2\">\n          <div class=\"formula-panel\"><span class=\"fn\">=QuotedPrice / 100 * FaceValue</span><span class=\"comment\">=99.59 / 100 * $1,000</span><span class=\"result\">Dollar price = $995.90</span></div>\n          <div class=\"formula-panel\"><span class=\"fn\">=AnnualInterest / DollarPrice</span><span class=\"comment\">=(4% * $1,000) / $995.90</span><span class=\"result\">Current yield = 4.02%</span></div>\n          <div class=\"card tint\"><h3>Total purchase cost</h3><p>$995.90 &times; 5 bonds = <strong>$4,979.50</strong></p></div>\n          <div class=\"card\"><h3>Total annual interest</h3><p>$40 &times; 5 bonds = <strong>$200.00</strong></p></div>\n        </div>\n      </section>\n\n      <section class=\"slide paper\" data-section=\"3\">\n        <div class=\"eyebrow\">Live You Try It</div>\n        <h2>Pause 4: convert the bond quote</h2>\n        <div class=\"rule terra-rule\"></div>\n        <div class=\"grid-2\">\n          <div class=\"card tint\"><h3>Enter the givens</h3><p>$1,000 face value, 4% stated interest, 99.59 quoted price, and 5 bonds.</p></div>\n          <div class=\"card\"><h3>Build the formulas</h3><p>Calculate dollar price, total cost, annual interest, total annual interest, and current yield.</p></div>\n        </div>\n      </section>\n\n      <section class=\"slide paper\" data-section=\"3\">\n        <div class=\"eyebrow\">Worked Example</div>\n        <h2>NAV prices one share of the fund</h2>\n        <div class=\"rule terra-rule\"></div>\n        <div class=\"grid-2\">\n          <div class=\"formula-panel\"><span class=\"fn\">=(Holdings - Liabilities) / Shares</span><span class=\"comment\">=($5,550,000 - $770,000) / 600,000</span><span class=\"result\">NAV = $7.97/share</span></div>\n          <div class=\"formula-panel\"><span class=\"fn\">=NAV * SharesToBuy</span><span class=\"comment\">=$7.97 * 80</span><span class=\"result\">Purchase cost = $637.60</span></div>\n          <div class=\"card tint\"><h3>What the number means</h3><p>One mutual fund share represents a claim on the fund&apos;s net assets after liabilities.</p></div>\n          <div class=\"card\"><h3>Live You Try It Pause 5</h3><p>Enter $5,550,000, $770,000, 600,000 shares, and 80 purchase shares; then build NAV and purchase cost formulas.</p></div>\n        </div>\n      </section>\n\n      <section class=\"slide terra\" data-section=\"3\">\n        <div class=\"eyebrow\">Common Mistake</div>\n        <h2>Do not treat a bond quote as dollars</h2>\n        <div class=\"grid-2\" style=\"margin-top:34px;\">\n          <div class=\"card\"><h3>Incorrect</h3><p>A quote of <strong>99.59</strong> means the bond costs $99.59.</p></div>\n          <div class=\"card\"><h3>Correct</h3><p>A quote of <strong>99.59</strong> means 99.59% of $1,000, or $995.90.</p></div>\n        </div>\n        <p style=\"margin-top:28px;\">That conversion changes every downstream answer: total cost, current yield, and premium/discount classification.</p>\n      </section>\n\n      <section class=\"slide paper\" data-section=\"4\">\n        <div class=\"eyebrow\">Class Challenge</div>\n        <h2>Use the model to make one client recommendation</h2>\n        <div class=\"rule\"></div>\n        <div class=\"grid-2\">\n          <div class=\"card\"><h3>Begin in class</h3><p>Build linked stock, bond, and fund calculations. Then link those results into one comparison table.</p></div>\n          <div class=\"card tint\"><h3>Finish for homework</h3><p>Test the $8,000 budget, income-or-return threshold, and lower-risk proxy. Select an eligible alternative and defend it with evidence.</p></div>\n        </div>\n      </section>\n\n      <section class=\"slide paper\" data-section=\"4\">\n        <div class=\"eyebrow\">FormulaReferenceCard</div>\n        <h2>Use syntax as a checklist, not a crutch</h2>\n        <div class=\"rule\"></div>\n        <div class=\"grid-3\">\n          <div class=\"card tint\"><h3>Stock quote</h3><p>=Ask - Bid<br>=Dividend / Price</p></div>\n          <div class=\"card\"><h3>Stock return</h3><p>=(NetProceeds - Cost + Dividends) / Cost</p></div>\n          <div class=\"card tint\"><h3>Decision tests</h3><p>=IF(OR(...),1,0)<br>=IF(AND(...),1,0)</p></div>\n        </div>\n      </section>\n\n      <section class=\"slide paper\" data-section=\"4\">\n        <div class=\"eyebrow\">Discussion</div>\n        <h2>What would make MAGH client-ready?</h2>\n        <div class=\"rule gold-rule\"></div>\n        <div class=\"grid-2\">\n          <div class=\"card\"><h3>Question 1</h3><p>Is a 6.12% ROI automatically attractive? What else should Meridian compare it against?</p></div>\n          <div class=\"card tint\"><h3>Question 2</h3><p>When would a lower-yielding bond or diversified fund be the smarter recommendation?</p></div>\n        </div>\n      </section>\n\n      <section class=\"slide dark\" data-section=\"4\">\n        <div class=\"gradient-bar\"></div>\n        <div class=\"eyebrow\">Close</div>\n        <h1>Inputs first. Formulas second. Advice last.</h1>\n        <p class=\"subtitle\">Next: connect investment math to financial statement analysis.</p>\n      </section>\n    </main>\n  </div>\n  <div class=\"nav\">\n    <button onclick=\"prevSlide()\" aria-label=\"Previous slide\">&larr;</button>\n    <span class=\"counter\" id=\"counter\">1 / 22</span>\n    <button onclick=\"nextSlide()\" aria-label=\"Next slide\">&rarr;</button>\n    <button onclick=\"toggleNotes()\" aria-label=\"Toggle speaker notes\">N</button>\n  </div>\n  <aside class=\"notes\" id=\"notes\"><strong>Speaker Notes</strong><span id=\"notes-text\"></span></aside>\n  <script type=\"application/json\" id=\"speaker-notes\">\n[\n  \"Welcome students to MATH-M10-L01. Today Meridian Advisory Group is using Excel to turn investment data into a recommendation.\",\n  \"Frame the agenda around three moves: stock quote reading, return measurement, and product comparison.\",\n  \"The learning goals are practical. Students should leave with calculation skill and interpretation skill.\",\n  \"Connect this lesson back to time value of money. Investments are cash-flow decisions, not just vocabulary.\",\n  \"Part 1 starts with stocks. The key teaching point is that a stock quote is a map of inputs.\",\n  \"Ask students what each quote field means before calculating. Emphasize bid, ask, last price, low, P/E, and dividend per share.\",\n  \"Walk the three formulas in order. Say the Excel syntax before the arithmetic so students hear the spreadsheet habit first.\",\n  \"Pause for workbook work. Have students enter the exact slide givens first, then build formulas in yellow cells.\",\n  \"Part 2 moves from quote reading to return measurement. Preferred dividends and ROI are both order-of-operations problems.\",\n  \"Work the preferred dividend waterfall. Preferred shareholders are paid first, then common shareholders split the remainder.\",\n  \"Pause for workbook work. Students should reference the input cells, not type the final answer into formulas.\",\n  \"Walk ROI as a full transaction. Point out that both commissions and dividends matter.\",\n  \"Pause for workbook work. Encourage students to build helper formulas instead of one giant ROI formula first.\",\n  \"Part 3 changes the investment product, but the workflow stays the same: identify inputs, build formulas, interpret.\",\n  \"Stress that bond quotes are percentages of par. This is the most common calculation trap.\",\n  \"Pause for workbook work. Students convert the quote, compute cost, interest, and current yield.\",\n  \"Walk NAV as a per-share pricing formula. Connect mutual fund pricing to fund holdings, liabilities, and shares outstanding, then pause for students to complete the NAV Live You Try It block.\",\n  \"Use the common mistake slide to slow students down. A quote of 99.59 is not a dollar price.\",\n  \"Transition to Class Challenge. Start the three calculation blocks and comparison links together in class, then have students finish the constraint tests, recommendation, and explanation for homework. Only Class Challenge is graded; Live You Try It remains self-checking practice.\",\n  \"Point students to the FormulaReferenceCard after they identify the needed metric. The new IF, OR, and AND patterns help them turn the client brief into visible pass-fail tests.\",\n  \"Use discussion to push beyond arithmetic. A correct calculation still needs investment context.\",\n  \"Close by repeating the workflow: inputs first, formulas second, advice last.\"\n]\n  </script>\n  <script>\n    var W=1280,H=720,deck=document.querySelector('.deck-shell'),slides=Array.from(document.querySelectorAll('.slide')),current=0,notesOpen=false,notes=JSON.parse(document.getElementById('speaker-notes').textContent);\n    function fit(){var s=Math.min(window.innerWidth/W,window.innerHeight/H);deck.style.transform='translate('+((innerWidth-W*s)/2)+'px,'+((innerHeight-H*s)/2)+'px) scale('+s+')'}\n    function show(){slides.forEach(function(slide,index){slide.classList.toggle('active',index===current)});document.getElementById('counter').textContent=(current+1)+' / '+slides.length;updateTabs();if(notesOpen){document.getElementById('notes-text').textContent=notes[current]||''}}\n    function goTo(n){current=Math.max(0,Math.min(slides.length-1,n));show()}\n    function nextSlide(){goTo(current+1)}\n    function prevSlide(){goTo(current-1)}\n    function jumpSection(section){var index=slides.findIndex(function(slide){return Number(slide.dataset.section)===section});if(index>=0){goTo(index)}}\n    function updateTabs(){var section=Number(slides[current].dataset.section);document.querySelectorAll('.tab').forEach(function(tab){tab.classList.toggle('active',Number(tab.dataset.section)===section)})}\n    function toggleNotes(){notesOpen=!notesOpen;document.getElementById('notes').classList.toggle('visible',notesOpen);show()}\n    window.addEventListener('resize',fit);document.addEventListener('keydown',function(event){if(event.key==='ArrowRight'||event.key===' '){event.preventDefault();nextSlide()}if(event.key==='ArrowLeft'){event.preventDefault();prevSlide()}if(event.key==='n'||event.key==='N'){toggleNotes()}});fit();show();\n  </script>\n</body>\n</html>\n"
}
